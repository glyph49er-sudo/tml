# ============ REQUIRED ============
# Discord Developer Portal -> your TML application
DISCORD_TOKEN=
CLIENT_ID=
# Right-click the TML server icon -> Copy Server ID (Developer Mode on)
GUILD_ID=

# Role pinged when a team opens up (members get it from the "join the waitlist!" button).
# If blank, the bot looks for a role named WAITLIST_ROLE_NAME.
WAITLIST_ROLE_ID=
WAITLIST_ROLE_NAME=waitlist

# Removed when someone gets an NFL team role, given back when they lose it.
# If blank, the bot looks for a role named WAITLIST_COACH_ROLE_NAME.
# (It may be the same role as WAITLIST_ROLE_ID if your server uses one role.)
WAITLIST_COACH_ROLE_ID=
WAITLIST_COACH_ROLE_NAME=Waitlist Coach

# ============ CHANNELS (pre-filled with the IDs you gave) ============
TEAM_OPENED_CHANNEL_ID=1481828808087699516
OPEN_TEAMS_CHANNEL_ID=1563478213630632006
PROSPECT_CHANNEL_ID=1561708316000784384
PROSPECT_STATS_CHANNEL_ID=1570602743834611924
FRANCHISE_HUB_CHANNEL_ID=1438019992347082823
